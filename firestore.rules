rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      // Any authenticated user can read patient profiles.
      // This allows the doctor dashboard (signed in anonymously) to query
      // by pairingPin and fetch patient records.
      // Write is restricted to the document owner only.
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Telemetry Subcollection
      match /telemetry/{logId} {
        // Patients can write telemetry to their own profile
        // Any authenticated user (including doctors) can read telemetry
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow read: if isAuthenticated();
      }
    }

    // Audit Logs - any authenticated user can write (doctors logging access)
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if false; // Only accessible via Admin SDK / Firebase Console
    }
  }
}
